# SQLite file (relative to the project root). For PostgreSQL use postgresql://user:pass@host:5432/db
DATABASE_URL="file:./prisma/dev.db"

# AI provider for syllabus extraction, assignment generation, and evaluation. Set ONE of these keys
# (server-only, never sent to the browser). With neither, the built-in offline generator/evaluator is used.
# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Optional model override (default claude-opus-5-5)
ANTHROPIC_MODEL=""
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override (default gemini-flash-latest)
GEMINI_MODEL=""
# Optional: force a provider when both keys are set ("anthropic" or "gemini")
AI_PROVIDER=""

# First faculty account created by `npm run db:seed`
SEED_FACULTY_EMAIL="faculty@college.edu"
SEED_FACULTY_NAME="Faculty Admin"
SEED_FACULTY_PASSWORD="ChangeMe-2026"

# Private storage for uploads (outside public/). Created automatically.
STORAGE_DIR="./storage"
# Upload limits
MAX_ZIP_MB=20
MAX_EXCEL_MB=5
MAX_SYLLABUS_MB=10
