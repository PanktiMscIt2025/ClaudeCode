// AssignAI data model (PostgreSQL, e.g. a free Neon database).
// JSON-shaped columns are stored as TEXT and validated in lib/ so the schema stays portable.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  role               String // "FACULTY" | "STUDENT"
  loginId            String   @unique // faculty email or student enrollment number (stored upper-case)
  name               String
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  disabled           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions           Session[]
  coursesTaught      Course[]
  enrollments        CourseStudent[]
  studentAssignments StudentAssignment[]
  auditLogs          AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the cookie token; the raw token is never stored
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Course {
  id          String          @id @default(cuid())
  code        String
  name        String
  facultyId   String
  createdAt   DateTime        @default(now())
  faculty     User            @relation(fields: [facultyId], references: [id])
  students    CourseStudent[]
  syllabus    Syllabus?
  assignments Assignment[]

  @@unique([facultyId, code])
}

model CourseStudent {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

model Syllabus {
  id            String   @id @default(cuid())
  courseId      String   @unique
  fileName      String
  extractedText String
  topics        String // JSON string[]
  outcomes      String // JSON string[]
  uploadedAt    DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Assignment {
  id            String              @id @default(cuid())
  courseId      String
  code          String // short prefix for version codes, e.g. "A1"
  title         String
  topics        String // JSON string[]
  difficulty    String // "EASY" | "MEDIUM" | "HARD"
  questionCount Int
  totalMarks    Int                 @default(30)
  status        String              @default("DRAFT") // DRAFT | GENERATING | REVIEW | PUBLISHED
  dueAt         DateTime
  rubric        String              @default("[]") // JSON RubricCriterion[] shared by every version (comparable marking)
  blueprint     String              @default("{}") // JSON question plan every version follows
  generator     String              @default("ai") // "ai" (Claude) | "offline" (built-in templates, no API key)
  progress      Int                 @default(0) // versions generated in the current run
  error         String?
  createdAt     DateTime            @default(now())
  publishedAt   DateTime?
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versions      StudentAssignment[]

  @@index([courseId])
}

/// The exact assignment version issued to one student (snapshot, never regenerated after publish).
model StudentAssignment {
  id            String       @id @default(cuid())
  assignmentId  String
  studentId     String
  version       String // e.g. A1-V03
  scenario      String
  questions     String // JSON Question[]
  rubric        String // JSON RubricCriterion[]
  modelSolution String // JSON, faculty-only
  instructions  String
  fingerprint   String // normalized text used for near-duplicate detection
  similarity    Float        @default(0)
  createdAt     DateTime     @default(now())
  assignment    Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissions   Submission[]

  @@unique([assignmentId, studentId])
  @@unique([assignmentId, version])
  @@index([studentId])
}

model Submission {
  id                  String            @id @default(cuid())
  studentAssignmentId String
  fileName            String
  sizeBytes           Int
  files               String            @default("[]") // JSON string[]: accepted files inside the ZIP
  rejectedFiles       String            @default("[]") // JSON string[]: blocked entries
  extractedText       String? // bounded text gathered for evaluation
  status              String            @default("QUEUED") // QUEUED | EVALUATING | EVALUATED | NEEDS_REVIEW | FAILED
  reviewReason        String?
  submittedAt         DateTime          @default(now())
  studentAssignment   StudentAssignment @relation(fields: [studentAssignmentId], references: [id], onDelete: Cascade)
  evaluation          Evaluation?
  file                SubmissionFile?

  @@index([studentAssignmentId])
}

/// The uploaded ZIP, kept in the database (so it survives restarts on hosts without a disk).
/// Deleted once marks are approved unless retention is enabled.
model SubmissionFile {
  submissionId String     @id
  data         Bytes
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id           String                @id @default(cuid())
  submissionId String                @unique
  aiTotal      Float
  finalTotal   Float
  feedback     String
  evidence     String                @default("[]") // JSON string[]
  status       String                @default("PROVISIONAL") // PROVISIONAL | APPROVED
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  submission   Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criteria     EvaluationCriterion[]
}

model EvaluationCriterion {
  id           String     @id @default(cuid())
  evaluationId String
  position     Int
  criterion    String
  maxMarks     Float
  aiMarks      Float
  finalMarks   Float
  comment      String     @default("")
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. GRADE_APPROVED, PASSWORD_RESET, STUDENTS_IMPORTED
  target    String // e.g. "submission:<id>"
  details   String   @default("{}") // JSON, never contains passwords
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Minimal DB-backed job queue for AI generation and evaluation (no Redis needed).
model Job {
  id        String   @id @default(cuid())
  type      String // GENERATE_ASSIGNMENT | EVALUATE_SUBMISSION
  payload   String // JSON
  status    String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts  Int      @default(0)
  error     String?
  runAfter  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
}
