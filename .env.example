# SQLite file (relative to the project root). For PostgreSQL use postgresql://user:pass@host:5432/db
DATABASE_URL="file:./prisma/dev.db"

# Anthropic API key for assignment generation and evaluation (server-only, never sent to the browser).
# Leave empty to use the built-in offline generator/evaluator (useful for demos and tests).
ANTHROPIC_API_KEY=""
# Optional model override
ANTHROPIC_MODEL=""

# First faculty account created by `npm run db:seed`
SEED_FACULTY_EMAIL="faculty@college.edu"
SEED_FACULTY_NAME="Faculty Admin"
SEED_FACULTY_PASSWORD="ChangeMe-2026"

# Private storage for uploads (outside public/). Created automatically.
STORAGE_DIR="./storage"
# Upload limits
MAX_ZIP_MB=20
MAX_EXCEL_MB=5
MAX_SYLLABUS_MB=10
