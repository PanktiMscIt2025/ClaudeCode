# PostgreSQL connection string. Free hosted option: https://neon.tech (copy the connection string from the dashboard).
# Local example: postgresql://user:password@localhost:5432/assignai
DATABASE_URL=""
# Optional: a direct (non-pooled) connection for migrations. Not needed for Neon (derived automatically).
DIRECT_URL=""

# AI provider for syllabus extraction, assignment generation, and evaluation. Set ONE of these keys
# (server-only, never sent to the browser). With neither, the built-in offline generator/evaluator is used.
# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Optional model override (default claude-opus-5-5)
ANTHROPIC_MODEL=""
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override (default gemini-flash-latest)
GEMINI_MODEL=""
# Optional: force a provider when both keys are set ("anthropic" or "gemini")
AI_PROVIDER=""

# First faculty account created by `npm run db:seed`
SEED_FACULTY_EMAIL="faculty@college.edu"
SEED_FACULTY_NAME="Faculty Admin"
SEED_FACULTY_PASSWORD="ChangeMe-2026"

# Upload limits (uploaded ZIPs are stored in the database until marks are approved)
MAX_ZIP_MB=20
MAX_EXCEL_MB=5
MAX_SYLLABUS_MB=10
